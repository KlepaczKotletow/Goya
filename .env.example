# Production origin. Drives canonicals, sitemap, robots and the URLs Stripe
# redirects back to. Set this in Vercel the moment the domain resolves.
NEXT_PUBLIC_SITE_URL=https://okularygoya.pl

# Stripe — from the client's account (Developers → API keys / Webhooks).
# The secret key never reaches the browser; keep it out of git.
STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
# The endpoint must subscribe to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# payment_intent.succeeded, payment_intent.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key, inlined into the browser bundle at build time (so changing it
# in Vercel needs a redeploy, not just a save). Drives the Apple Pay / Google Pay
# express buttons; without it they degrade to an ordinary "Kup teraz" button.
# The domain must also be registered at
# dashboard.stripe.com/settings/payment_method_domains or no wallet ever appears.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Google Sheets intake (scripts/google-apps-script/Kod.gs).
GOYA_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOYA_SHEETS_WEBHOOK_SECRET=

# Supabase (catalogue + order fallback). Defaults are committed in lib/, these
# only override them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# InPost Geowidget token — manager.paczkomaty.pl → Moje konto → API → Geowidget.
# Designed to be public, but locked to a referrer domain, so it works on
# okularygoya.pl and not on per-deploy Vercel preview URLs. When set, the
# checkout shows InPost's own map; when empty, it uses our own map over the
# same public InPost point data.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# Map tiles for the Paczkomat picker. Defaults to OpenStreetMap, whose usage
# policy offers no SLA for commercial use — set this to a paid provider's
# {z}/{x}/{y} template if tile traffic ever grows.
NEXT_PUBLIC_MAP_TILE_URL=
