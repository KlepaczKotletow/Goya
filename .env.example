# Production origin. Drives canonicals, sitemap, robots and the URLs Stripe
# redirects back to. Set this in Vercel the moment the domain resolves.
NEXT_PUBLIC_SITE_URL=https://okularygoya.pl

# Stripe — from the client's account (Developers → API keys / Webhooks).
# The secret key never reaches the browser; keep it out of git.
STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Sheets intake (scripts/google-apps-script/Kod.gs).
GOYA_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOYA_SHEETS_WEBHOOK_SECRET=

# Supabase (catalogue + order fallback). Defaults are committed in lib/, these
# only override them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
